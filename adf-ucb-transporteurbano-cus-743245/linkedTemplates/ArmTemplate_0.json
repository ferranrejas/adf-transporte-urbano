		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "adf-ucb-transporteurbano-cus-743245"
		},
		"as_transporte_accountKey": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"accountKey\"de \"as_transporte\""
		},
		"dw_transporte_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"dw_transporte\""
		},
		"erp_transporte_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"erp_transporte\""
		},
		"as_transporte_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://saucbtransporte743246.dfs.core.windows.net/"
		},
		"dw_transporte_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-ucb-server-transporteurbano-976755.database.windows.net"
		},
		"dw_transporte_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dw_transporte"
		},
		"dw_transporte_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "FerranVel"
		},
		"erp_transporte_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-ucb-server-transporteurbano-976755.database.windows.net"
		},
		"erp_transporte_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "erp_transporte_db"
		},
		"erp_transporte_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "FerranVel"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
